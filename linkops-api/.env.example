POSTGRES_DB=linkops
POSTGRES_USER=linkops
POSTGRES_PASSWORD=linkops
POSTGRES_PORT=5434
API_PORT=8081

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081
DATABASE_URL=jdbc:postgresql://localhost:5434/linkops
DATABASE_USERNAME=linkops
DATABASE_PASSWORD=linkops

# Lista separada por vírgulas. Em produção, use apenas domínios HTTPS reais.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:4200,http://localhost:19006

# Use a long, random value outside development. Never commit the real secret.
JWT_SECRET=replace-with-a-secure-random-secret-of-at-least-32-bytes
JWT_ISSUER=linkops-api
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Recuperação de palavra-passe. Use o URL do ecrã Vue em produção.
PASSWORD_RESET_EXPIRATION=5m
PASSWORD_RESET_FRONTEND_URL=http://localhost:5174/reset-password
MAIL_FROM=no-reply@linkops.co.mz
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
# Por omissão, apenas MAIL_HOST é confiado durante o handshake TLS.
MAIL_SSL_TRUST=
MAIL_SSL_CHECK_SERVER_IDENTITY=true
